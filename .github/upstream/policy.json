{
  "version": 1,
  "upstream": "pingdotgg/t3code",
  "repository": "glyahh/T3.1-code",
  "repositoryId": 1441172085,
  "personalBranch": "codex/upstream-unattended-baseline",
  "candidatePrefix": "codex/upstream/",
  "maxRounds": 2,
  "taskTimeoutMinutes": 120,
  "features": [
    {
      "id": "chinese-settings",
      "paths": ["apps/web/src/components/settings/"],
      "preserve": "中文设置、搜索及设置入口可用"
    },
    {
      "id": "timeline",
      "paths": ["apps/web/src/components/chat/", "packages/client-runtime/src/work-log/"],
      "preserve": "消息、思考和工具活动不丢失、不重复，滚动锚点与跟随符合当前行为"
    },
    {
      "id": "previews",
      "paths": [
        "apps/web/src/components/ChatMarkdown.tsx",
        "apps/web/src/components/media/",
        "apps/web/src/components/ui/dialog.tsx"
      ],
      "preserve": "图片、视频、HTML、Mermaid及内容预览支持打开、关闭和恢复"
    },
    {
      "id": "antigravity",
      "paths": [
        "apps/server/src/provider/",
        "apps/server/src/orchestration-v2/",
        "packages/provider-acp/"
      ],
      "preserve": "首字响应、会话恢复、停止、审批和重连不退化"
    },
    {
      "id": "custom-update",
      "paths": ["apps/desktop/src/updates/"],
      "preserve": "定制安装不被官方自动更新覆盖"
    },
    {
      "id": "shared-contracts",
      "paths": [
        "packages/contracts/",
        "packages/client-runtime/",
        "apps/mobile/",
        "apps/server/src/vcs/",
        "apps/web/src/state/",
        "apps/web/src/appInit.tsx"
      ],
      "preserve": "检查所有受影响客户端、提供方及本地、远程、隧道连接"
    }
  ],
  "requiredEvidence": [
    "unit",
    "integration",
    "e2e",
    "smoke",
    "regression",
    "api",
    "contract",
    "performance",
    "load",
    "stress",
    "security",
    "compatibility",
    "fault",
    "chaos",
    "rollout",
    "canary",
    "ab",
    "uat"
  ],
  "streamingAcceptance": {
    "localEventToDisplayP95Ms": 200,
    "sessions": [1, 4, 8],
    "updatesPerSessionPerSecond": 50,
    "loadMinutesPerCase": 15,
    "combinedFaultMinutes": 30,
    "rolloutTurns": 20,
    "firstProviderCanaryTurns": 5,
    "realCallsPerAvailableProvider": 3,
    "abSamplesPerVersion": 20,
    "maximumLocalLatencyRegressionPercent": 10
  },
  "cloudUiToolsAllowed": true,
  "verification": [
    {
      "name": "personal-source",
      "command": "node",
      "args": ["{control}/scripts/upstream-preservation.mjs"],
      "categories": []
    },
    {
      "name": "personal-behavior",
      "command": "vp",
      "args": [
        "test",
        "run",
        "packages/client-runtime/src/work-log/presentation.test.ts",
        "apps/web/src/components/chat/MessagesTimeline.logic.test.ts",
        "apps/web/src/components/chat/MessagesTimeline.active-tools.test.ts",
        "apps/web/src/components/chat/TimelineWorkGroupRows.logic.test.ts",
        "apps/web/src/components/settings/settingsSearch.test.ts",
        "apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.test.ts",
        "apps/server/src/orchestration-v2/Adapters/CodexAdapterV2.test.ts",
        "apps/server/src/orchestration-v2/RestartContinuation.test.ts",
        "apps/server/src/provider/acp/AntigravityResumeSafety.test.ts",
        "apps/desktop/src/updates/DesktopUpdates.test.ts",
        "apps/server/src/htmlRender/HtmlRender.test.ts",
        "packages/client-runtime/src/filePreview.test.ts"
      ],
      "categories": ["unit", "regression"]
    },
    {
      "name": "event-integration",
      "command": "vp",
      "args": [
        "test",
        "run",
        "apps/server/src/ws.test.ts",
        "apps/server/src/orchestration-v2/ThreadStream.test.ts",
        "apps/server/src/orchestration-v2/ShellStream.test.ts",
        "apps/server/src/orchestration-v2/WireProjection.test.ts"
      ],
      "categories": ["integration"]
    },
    {
      "name": "http-authorization",
      "command": "vp",
      "args": [
        "test",
        "run",
        "apps/server/src/http.test.ts",
        "apps/server/src/orchestration-v2/http.test.ts",
        "apps/server/src/auth/http.test.ts",
        "apps/server/src/auth/RpcAuthorization.test.ts"
      ],
      "categories": ["api", "security"]
    },
    {
      "name": "wire-contracts",
      "command": "vp",
      "args": [
        "test",
        "run",
        "packages/contracts/src/orchestrationV2.test.ts",
        "packages/contracts/src/settings.test.ts",
        "packages/contracts/src/modelSelection.test.ts"
      ],
      "categories": ["contract"]
    },
    {
      "name": "browser-components",
      "command": "vp",
      "args": [
        "test",
        "run",
        "apps/web/src/components/settings/settingsText.browser.test.tsx",
        "apps/web/src/components/chat/MessagesTimeline.browser.test.tsx",
        "apps/web/src/components/chat/ThreadRelationshipsControl.browser.test.tsx",
        "apps/web/src/components/chat/ChatMarkdownMedia.browser.test.tsx",
        "apps/web/src/components/chat/HtmlRenderFrame.browser.test.tsx"
      ],
      "categories": ["unit", "regression"]
    }
  ],
  "retainCoreRegressionTests": true,
  "automaticMerge": false,
  "automaticInstall": false,
  "automaticPublish": false,
  "testProfile": {
    "name": "unattended-upgrade",
    "personalSourceSha": "d1f91c5139becaaed79a266bf13b5faee4577e53",
    "upstreamSha": "322f6544dfad0a3c8a0c8cbecf2c7f7874b14268",
    "tag": "v0.1.7",
    "candidateBranch": "codex/upstream/unattended-v0.1.7",
    "productionEnabled": false,
    "automaticMerge": false,
    "automaticInstall": false,
    "automaticPublish": false
  }
}
